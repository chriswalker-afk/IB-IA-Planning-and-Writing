{
  "name": "ia-pathfinder",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "IB Mathematics IA Pathfinder - browser-local Planning and writing companion",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:core": "node --test tests/project-state.test.js tests/route-graph.test.js tests/coverage.test.js tests/planning-engine.test.js",
    "build": "node scripts/build.mjs",
    "audit:screens": "node scripts/audit-screen-inventory.mjs",
    "audit:screens:write": "node scripts/audit-screen-inventory.mjs --write"
  },
  "dependencies": {
    "docx": "9.5.3",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.449",
    "mathjax-full": "3.2.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
